<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}Linkbuilder{% endblock %}</title>
    <style>
      /* --- Global Reset & Base Styles --- */
      body {
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        background: #f4f4f9;
        color: #333;
        line-height: 1.5;
      }

      /* --- Common Components --- */
      .card {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
      }

      label {
        font-weight: bold;
        display: block;
        margin-top: 10px;
        font-size: 0.9rem;
      }

      input[type="text"],
      input[type="email"],
      input[type="password"],
      select,
      textarea,
      input[type="file"] {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-family: inherit;
        /* Ensure consistent height calculation across browsers */
        line-height: 1.5;
        font-size: 1rem;
      }

      button {
        cursor: pointer;
        font-family: inherit;
      }

      .alert {
        padding: 10px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 0.9rem;
      }

      .alert-success {
        background: #d4edda;
        color: #155724;
      }

      .alert-danger {
        background: #f8d7da;
        color: #721c24;
      }

      /* --- Password Toggle Utility --- */
      .password-field {
        position: relative;
        margin-top: 5px;
      }

      .password-field input {
        width: 100%;
        padding-right: 44px;
        box-sizing: border-box;
      }

      .password-toggle {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        right: 0;
        height: 80%;
        width: 40px;
        margin: 3px;
        padding: 0;
        background: transparent;
        color: #475569;
        border: 0;
        border-radius: 0 4px 4px 0;
      }

      .password-toggle:hover,
      .password-toggle.is-active {
        color: #0066cc;
      }

      .password-toggle:focus-visible {
        outline: 2px solid #0066cc;
      }

      .password-toggle svg {
        width: 20px;
        height: 20px;
        display: block;
        margin: auto;
      }
    </style>
    {% block extra_head %}{% endblock %}
  </head>
  <body>
    {% block content %}{% endblock %}
    {% block scripts %}
      <script>
        // Global utility for password visibility toggling
        function togglePasswordVisibility(toggleButton) {
          const input = toggleButton.parentElement.querySelector("input");
          if (!input) return;
          const visible = input.type === "text";
          input.type = visible ? "password" : "text";
          toggleButton.setAttribute("aria-label", visible ? "Show password" : "Hide password");
          toggleButton.classList.toggle("is-active", !visible);
        }
      </script>
    {% endblock %}
  </body>
</html>
{# --- Macros --- #}
{% macro password_field(name, label_text, autocomplete="off") %}
  <label for="{{ name }}">{{ label_text }}</label>
  <div class="password-field">
    <input id="{{ name }}"
           type="password"
           name="{{ name }}"
           autocomplete="{{ autocomplete }}"
           required />
    <button type="button"
            class="password-toggle"
            aria-label="Show password"
            onclick="togglePasswordVisibility(this)">
      <svg viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2"
           stroke-linecap="round"
           stroke-linejoin="round"
           aria-hidden="true">
        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
        <circle cx="12" cy="12" r="2.5" />
      </svg>
    </button>
  </div>
{% endmacro %}
{% macro render_flashes() %}
  {% set messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
    {% for category, message in messages %}<div class="alert alert-{{ category }}">{{ message }}</div>{% endfor %}
  {% endif %}
{% endmacro %}
