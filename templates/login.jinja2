{% extends "base.jinja2" %}
{% from "base.jinja2" import password_field, render_flashes %}
{% block title %}Admin Login{% endblock %}
{% block content %}
  <div style="display: flex;
              justify-content: center;
              align-items: center;
              min-height: 80vh">
    <div class="card" style="width: 100%; max-width: 360px;">
      <h2 style="margin-top: 0; text-align: center;">Admin Login</h2>
      {{ render_flashes() }}
      <form method="POST" action="/login">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
        <label>Username</label>
        <input type="text" name="username" required autofocus placeholder="Username" />
        {{ password_field('password', 'Password', 'current-password') }}
        <button type="submit"
                style="width: 100%;
                       padding: 10px;
                       margin-top: 20px;
                       background: #0066cc;
                       color: #fff;
                       border: none;
                       border-radius: 4px;
                       font-size: 1rem">Log In</button>
      </form>
    </div>
  </div>
{% endblock %}
