[Unit]
Description=LinkBuilder Flask Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/linkbuilder
EnvironmentFile=/etc/default/linkbuilder
ExecStartPre=/opt/linkbuilder/venv/bin/flask init-db
ExecStart=/opt/linkbuilder/venv/bin/python3 app.py

[Install]
WantedBy=multi-user.target
