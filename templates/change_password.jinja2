{% extends "base.jinja2" %}
{% from "base.jinja2" import password_field %}
{% block title %}Change Password{% endblock %}
{% block content %}
  <div style="display: flex;
              justify-content: center;
              align-items: center;
              min-height: 80vh;
              padding: 20px">
    <div class="card" style="width: 100%; max-width: 360px;">
      <h2 style="margin-top: 0; text-align: center;">Change Password</h2>
      <form method="POST" action="/change-password">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
        {{ password_field('current_password', 'Current Password', 'current-password') }}
        {{ password_field('new_password', 'New Password', 'new-password') }}
        {{ password_field('confirm_password', 'Confirm New Password', 'new-password') }}
        <button type="submit"
                style="width: 100%;
                       padding: 10px;
                       margin-top: 20px;
                       background: #0066cc;
                       color: #fff;
                       border: none;
                       border-radius: 4px;
                       font-size: 1rem">Change Password</button>
      </form>
      <a href="/"
         style="display: block;
                margin-top: 15px;
                text-align: center;
                color: #475569;
                text-decoration: none">Back to Admin</a>
    </div>
  </div>
{% endblock %}
